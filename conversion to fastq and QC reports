#!/bin/bash
#sempre adaptar os diretórios
  
##############################
# CONFIGURAÇÕES DO USUÁRIO
##############################

# Diretório base onde estão as subpastas com .sra
BASE_DIR="/storage2/pablooliveira/projects/Alana/datasetsGEO/GSE166160_alt"

# Diretório único para arquivos de saída
OUT_DIR="${BASE_DIR}/FASTQfiles"
mkdir -p "$OUT_DIR"

# Diretórios internos
FASTQ_DIR="${OUT_DIR}/fastq"
FASTQC_DIR="${OUT_DIR}/fastqc_reports"
MULTIQC_DIR="${OUT_DIR}/multiqc_summary"

mkdir -p "$FASTQ_DIR" "$FASTQC_DIR" "$MULTIQC_DIR"

# Threads para acelerar
THREADS=8

# Log para falhas
LOG_FAIL="${OUT_DIR}/failed_samples.log"
echo "Falhas registradas:" > "$LOG_FAIL"


###########################################
# 1. ENCONTRAR E CONVERTER TODOS .SRA
###########################################
echo ">>> INICIANDO CONVERSÕES SRA → FASTQ"

for SRA_FILE in $(find "$BASE_DIR" -type f -name "*.sra"); do
    SRR=$(basename "$SRA_FILE" .sra)

    echo "Convertendo: $SRR"

    fasterq-dump "$SRA_FILE" \
        --outdir "$FASTQ_DIR" \
        --threads "$THREADS" \
        --temp "$FASTQ_DIR/tmp_${SRR}" \
        --progress \
        || echo "$SRR" >> "$LOG_FAIL"

    # Compactação
    gzip "$FASTQ_DIR/${SRR}"*.fastq
done


###########################################
# 2. FASTQC PARA TODAS AS AMOSTRAS
###########################################
echo ">>> INICIANDO FASTQC PARA TODOS OS FASTQs"

fastqc "$FASTQ_DIR"/*.fastq.gz \
    --outdir "$FASTQC_DIR" \
    --threads "$THREADS" 


###########################################
# 3. MULTIQC AGREGANDO RESULTADOS
###########################################
echo ">>> RODANDO MULTIQC"

multiqc "$FASTQC_DIR" -o "$MULTIQC_DIR"


###########################################
# FIM DO PROCESSO
###########################################
echo ">>> CONCLUÍDO!"
echo "FASTQs em: $FASTQ_DIR"
echo "Relatórios FastQC em: $FASTQC_DIR"
echo "MultiQC em: $MULTIQC_DIR"
echo "Checar falhas: $LOG_FAIL"
