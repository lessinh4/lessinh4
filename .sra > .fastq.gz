#!/bin/bash

# Diretório com subpastas SRR 
BASE_DIR="/storage2/pablooliveira/projects/Alana/datasetsGEO/GSE166160_alt"

# Diretório final para armazenar os FASTQs
#no exemplo é FASTQfiles mas o nome é modificável
OUT_DIR="${BASE_DIR}/FASTQfiles"
mkdir -p "$OUT_DIR"

# Número de threads para acelerar o processamento
THREADS=8

# Log de falhas
LOG_FAIL="${BASE_DIR}/failed_conversions.log"
echo "Falhas de conversão:" > "$LOG_FAIL"

echo "Iniciando conversão de todos os arquivos .sra..."
echo "Saída unificada em: $OUT_DIR"
sleep 1

for SRA_FILE in $(find "$BASE_DIR" -type f -name "*.sra"); do
    SRR=$(basename "$SRA_FILE" .sra)
    
    echo "Convertendo $SRR..."

    fasterq-dump "$SRA_FILE" \
        --outdir "$OUT_DIR" \
        --threads "$THREADS" \
        --temp 
        --progress \
        || echo "$SRR" >> "$LOG_FAIL"

    # Compactação dos FASTQs gerados
    gzip "$OUT_DIR/${SRR}"*.fastq
done

echo "Processo concluído."
echo "Se houver falhas, consulte: $LOG_FAIL"

